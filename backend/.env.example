# Database
DATABASE_URL=postgresql://tito:metralleta@localhost:5432/tito_db

# Server
NODE_ENV=development
PORT=3000

# JWT
JWT_SECRET=dev-secret-key-change-in-production
JWT_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# API Documentation
API_VERSION=1.0.0
API_TITLE=Tito Metralleta API
API_DESCRIPTION=Sistema de Análisis de Trading

# ============================================================================
# BIBLIOTECA DE LAS LLAVES — Credenciales Canónicas (9 requieridas)
# ============================================================================

# Alpaca Paper Trading — Static API Key + Secret
# Get from: https://app.alpaca.markets/paper/settings (Paper Trading only)
ALPACA_API_KEY=your-alpaca-api-key-here
ALPACA_SECRET_KEY=your-alpaca-secret-key-here

# Massive (Polygon.io) — Option chain + Market snapshots
# Get from: https://polygon.io (free tier available)
MASSIVE_API_KEY=your-massive-api-key-here

# MarketSnack — Options flow internal API
# Cookie-based authentication via dashboard
MARKETSNACK_COOKIE=your-marketsnack-cookie-here

# Charles Schwab — 0DTE + OAuth2 Client Credentials
# Get from: https://developer.schwab.com (requires OAuth2 setup)
SCHWAB_CLIENT_ID=your-schwab-client-id-here
SCHWAB_CLIENT_SECRET=your-schwab-client-secret-here

# FRED (Federal Reserve Economic Data) — VIX historical data
# Get from: https://fred.stlouisfed.org/docs/api (free, no auth needed but key required)
FRED_API_KEY=your-fred-api-key-here

# NewsAPI — Financial headlines and sentiment
# Get from: https://newsapi.org (free tier available)
NEWS_API_KEY=your-newsapi-key-here

# TradingView Webhooks — Alerts ingestion (static bearer token)
# Generate in: TradingView alerts configuration, use as webhook secret
TRADINGVIEW_WEBHOOK_SECRET=your-tradingview-webhook-secret-here

# ============================================================================
# NOTAS DE SEGURIDAD
# ============================================================================
# - NUNCA comitear valores reales en .env.example
# - NUNCA usar demystrategy/demo values en producción
# - NUNCA compartir .env.local en repositorio (gitignore)
# - Rotacar credenciales regularmente si expuestas
# - Usar variables de ambiente para production (no .env)
# ============================================================================
