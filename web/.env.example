# Copia este archivo a .env.local y pon tu key real.
MASSIVE_API_KEY=tu_api_key_de_massive
MASSIVE_MAX_PAGES=40

# Cookie de sesión de app.marketsnack.com (para el sub-agente Time & Sales).
# DevTools → Network → request a /api/flow_feed → copia el header "Cookie" completo.
MARKETSNACK_COOKIE=

# Secreto compartido del webhook de TradingView (/api/tradingview).
# TradingView no manda headers, así que este valor viaja DENTRO del cuerpo de la alerta
# como "passphrase". Ponlo igual aquí y en la caja Message de la alerta. Genera uno largo
# y aleatorio; sin él el endpoint rechaza todo (503/401). NO commitear el valor real.
TRADINGVIEW_WEBHOOK_SECRET=

# Charles Schwab (Market Data) — fuente del option chain del Agente 0DTE: volumen,
# OI, griegos y nivel del índice SPX. OAuth2 client_credentials. Sin esto, /0dte no
# trae datos (el resto del app sigue con Massive). NO commitear valores reales.
SCHWAB_CLIENT_ID=tu_client_id_de_schwab
SCHWAB_CLIENT_SECRET=tu_client_secret_de_schwab
